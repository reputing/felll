{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "doujin-api",
  "main": "container-worker.js",
  "compatibility_date": "2025-09-01",
  // Built from the Dockerfile here (clones sinkaroid/jandapress, a Rust/Axum app).
  // wrangler builds + pushes it on `npm run doujin:container:deploy`.
  // ADULT source — see container-worker.js.
  "containers": [
    {
      "class_name": "DoujinContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "DoujinContainer", "name": "DOUJIN_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DoujinContainer"] }],
  "observability": { "enabled": true }
}
