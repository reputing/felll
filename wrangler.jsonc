{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felll",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // Members, lists, comments, video sources and the Jikan cache.
  // `npx wrangler d1 create felll` prints the id to paste here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "felll",
      "database_id": "afa6cc67-8758-46a9-a29f-0ed6165a34b5",
      "migrations_dir": "migrations"
    }
  ],
  // Keeps the Jikan cache warm so nobody waits on a cold MyAnimeList call.
  "triggers": { "crons": ["*/20 * * * *"] },
  // Public values. Secrets (KURO_SERVICE_KEY, STREAM_SIGNING_KEY_*) are set
  // with `wrangler secret put`, never here.
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "cupcake.gg",
    "KURO_URL": "https://kuro.rip",
    "REQUIRE_KURO_PLUS": "0"
  }
}
