{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "felll",
  "main": "worker.ts",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },
  // The public domain. Kept here so every deploy re-attaches it — wrangler
  // overrides the Worker's remote config with this file, so a custom domain set
  // only in the dashboard gets dropped on deploy.
  "routes": [
    { "pattern": "cupcake.gg", "custom_domain": true }
  ],
  // Members, lists, comments, video sources and the Jikan cache.
  // `npx wrangler d1 create felll` prints the id to paste here.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "felll",
      "database_id": "afa6cc67-8758-46a9-a29f-0ed6165a34b5",
      "migrations_dir": "migrations"
    }
  ],
  // Keeps the Jikan cache warm so nobody waits on a cold MyAnimeList call.
  "triggers": { "crons": ["*/20 * * * *"] },
  // The global chat room (live WebSocket fan-out). See chat-room.ts + worker.ts.
  "durable_objects": {
    "bindings": [{ "name": "CHAT", "class_name": "ChatRoom" }]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["ChatRoom"] }
  ],
  // Public values only. Secrets and API keys (KURO_SERVICE_KEY,
  // STREAM_SIGNING_KEY_*, TMDB_API_KEY, STREAM8_API_URL) are set with
  // `wrangler secret put`, never here — anything in this file is committed to
  // the repo. A deploy overrides the Worker's vars with this list, so a var set
  // only in the dashboard is dropped; put durable non-secret vars here.
  "vars": {
    "NEXT_PUBLIC_SITE_NAME": "cupcake.gg",
    "KURO_URL": "https://kuro.rip",
    "REQUIRE_KURO_PLUS": "0",
    // The catalog comes from `npm run sync` (AniList/Kitsu), never live Jikan.
    // This makes any stray live call fail fast instead of hanging on a timeout.
    "JIKAN_DISABLED": "1",
    // The Anivexa backend ("the bot"). Deploy anivexa-server/ as a Cloudflare
    // Container (npm run anivexa:container:deploy) and point this at its URL.
    "ANIVEXA_API_URL": "https://anivexa-api.matthewsjakael.workers.dev",
    // Second manga source (English fallback). Deploy consumet-server/ as a
    // Cloudflare Container (npm run consumet:container:deploy) and uncomment this,
    // pointing it at the deployed URL. Left unset = disabled (MangaDex only).
    // "CONSUMET_API_URL": "https://consumet-api.matthewsjakael.workers.dev",
    // Embed host for the movie players (overridable since it moves).
    "VIDCORE_EMBED_BASE": "https://vidcore.org"
  }
}
