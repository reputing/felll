{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "mango-api",
  "main": "container-worker.js",
  "compatibility_date": "2025-09-01",
  // Built from the Dockerfile here, which compiles la-lo-go/man-go from source
  // (Go). wrangler builds + pushes it on `npm run mango:container:deploy`.
  "containers": [
    {
      "class_name": "MangoContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "MangoContainer", "name": "MANGO_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MangoContainer"] }],
  "observability": { "enabled": true }
}
