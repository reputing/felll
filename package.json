{
  "name": "felll",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "setup:cloudflare": "bash scripts/setup-cloudflare.sh",
    "d1:schema": "wrangler d1 execute cupcake --remote --file d1/schema.sql",
    "d1:schema:local": "wrangler d1 execute cupcake --local --file d1/schema.sql",
    "anivexa:dev": "wrangler dev -c anivexa/wrangler.jsonc --port 8799",
    "anivexa:deploy": "wrangler deploy -c anivexa/wrangler.jsonc",
    "sync:catalog": "tsx scripts/sync-anilist.ts",
    "sync:airing": "tsx scripts/sync-anilist.ts --airing",
    "sync:ratings": "tsx scripts/sync-ratings.ts",
    "upload": "tsx scripts/upload-episode.ts",
    "upload:folder": "tsx scripts/upload-folder.ts",
    "upload:watch": "tsx scripts/upload-folder.ts --watch"
  },
  "dependencies": {
    "hls.js": "1.7.3",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tus-js-client": "4.3.1",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
