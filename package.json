{
  "name": "felll",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "db:migrate": "wrangler d1 migrations apply felll --remote",
    "db:migrate:local": "wrangler d1 migrations apply felll --local",
    "sync": "tsx scripts/sync.ts",
    "sync:jikan": "tsx scripts/sync-jikan.ts",
    "upload": "tsx scripts/upload-episode.ts",
    "upload:folder": "tsx scripts/upload-folder.ts",
    "upload:watch": "tsx scripts/upload-folder.ts --watch",
    "anivexa:deploy": "wrangler deploy -c anivexa/wrangler.jsonc",
    "anivexa:container:deploy": "wrangler deploy -c anivexa-server/wrangler.jsonc",
    "moviebox:container:deploy": "wrangler deploy -c moviebox-server/wrangler.jsonc",
    "consumet:container:deploy": "wrangler deploy -c consumet-server/wrangler.jsonc",
    "vortexscans:container:deploy": "wrangler deploy -c vortexscans-server/wrangler.jsonc",
    "mangareader:container:deploy": "wrangler deploy -c mangareader-server/wrangler.jsonc",
    "manga-id:container:deploy": "wrangler deploy -c manga-id-server/wrangler.jsonc",
    "mango:container:deploy": "wrangler deploy -c mango-server/wrangler.jsonc",
    "comick:container:deploy": "wrangler deploy -c comick-server/wrangler.jsonc",
    "doujin:container:deploy": "wrangler deploy -c jandapress-server/wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-progress": "1.2.1",
    "@radix-ui/react-select": "2.4.1",
    "@radix-ui/react-slot": "1.5.0",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "hls.js": "1.7.3",
    "lucide-react": "1.61.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "1.20.12",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "tus-js-client": "4.3.1",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "wrangler": "4.151.3"
  }
}
