{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "manga-id-api",
  "main": "container-worker.js",
  "compatibility_date": "2025-09-01",
  // Built from the Dockerfile here, which compiles febryardiansyah/manga-api from
  // source (Node + tsc). wrangler builds + pushes it on
  // `npm run manga-id:container:deploy`.
  "containers": [
    {
      "class_name": "MangaIdContainer",
      "image": "./Dockerfile",
      "max_instances": 2,
      "instance_type": "basic"
    }
  ],
  "durable_objects": {
    "bindings": [{ "class_name": "MangaIdContainer", "name": "MANGA_ID_CONTAINER" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["MangaIdContainer"] }],
  "observability": { "enabled": true }
}
