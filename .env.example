# --- Site (Next.js; also set these in Cloudflare: vars or `wrangler secret put`)
NEXT_PUBLIC_SITE_NAME=Cupcake
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Cloudflare Stream: customer subdomain shown in Stream > any video > Embed,
# e.g. customer-abc123.cloudflarestream.com
STREAM_CUSTOMER_DOMAIN=
# Signing key from `POST /accounts/{id}/stream/keys` (id + base64 "jwk").
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_KEY_JWK=

# --- Scripts only (sync + upload). Never expose these to the site.
SUPABASE_SERVICE_ROLE_KEY=
CLOUDFLARE_ACCOUNT_ID=
# API token with "Stream:Edit" permission.
CLOUDFLARE_STREAM_API_TOKEN=
