# --- Site (Next.js on Cloudflare Workers)
NEXT_PUBLIC_SITE_NAME=Cupcake

# Catalog / search / episodes live in Cloudflare D1, reached through the `DB`
# binding in wrangler.jsonc — no runtime secret needed by the site for it.

# Cloudflare Stream: customer subdomain shown in Stream > any video > Embed,
# e.g. customer-abc123.cloudflarestream.com (only if you self-host video).
STREAM_CUSTOMER_DOMAIN=
# Signing key from `POST /accounts/{id}/stream/keys` (id + base64 "jwk").
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_KEY_JWK=

# --- Anivexa aggregator (optional). When set, episodes and streams for titles
# you don't self-host are pulled from the Anivexa API by AniList ID across its
# 12 providers. Leave blank to use self-hosted sources only. The backend is
# vendored in anivexa/ (npm run anivexa:dev / anivexa:deploy).
# Dev: http://localhost:8799  Prod: https://anivexa-api.<account>.workers.dev
ANIVEXA_API_URL=

# --- Scripts only (catalog sync + uploads). Never exposed to the site.
# A Cloudflare API token with "D1:Edit" (and "Stream:Edit" if you upload video).
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# The D1 database id (wrangler d1 create cupcake, or the Cloudflare dashboard).
CLOUDFLARE_D1_DATABASE_ID=
