# --- Local development (`npm run dev`). In production these are Worker vars /
# secrets: see wrangler.jsonc and `wrangler secret put`. For `next dev`, the
# Worker-side values below also go in .dev.vars.

# kuro sign-in. KURO_SERVICE_KEY is kuro's Supabase service-role key: it checks
# kuro's one-time sign-in codes and reads profiles. Secret, Worker only.
KURO_URL=https://kuro.rip
KURO_SUPABASE_URL=https://YOUR-KURO-PROJECT.supabase.co
KURO_SERVICE_KEY=
# 1 = only kuro+ members get in
REQUIRE_KURO_PLUS=0
# comma-separated kuro handles that can moderate comments and requests
ADMIN_HANDLES=

# Optional: your own Jikan instance instead of api.jikan.moe
# JIKAN_URL=https://jikan.example.com/v4

# Cloudflare Stream playback (signed URLs)
STREAM_CUSTOMER_DOMAIN=
STREAM_SIGNING_KEY_ID=
STREAM_SIGNING_KEY_JWK=

# Anime streams: the Anivexa aggregator ("the bot")
# ANIVEXA_API_URL=https://anivexa-api.example.workers.dev

# Movies & series. TMDB powers the catalog (browse/search/detail) and the embed
# players; 8Stream resolves a movie's direct HLS stream (deploy
# github.com/himanshu8443/8StreamApi and point STREAM8_API_URL at it). Without
# TMDB_API_KEY the /movies section shows a "coming soon" state.
TMDB_API_KEY=
# STREAM8_API_URL=https://8stream.example.com
# Optional: override the VidCore embed host if it moves
# VIDCORE_EMBED_BASE=https://vidcore.org

# --- Upload scripts only. Never give these to the Worker.
CLOUDFLARE_ACCOUNT_ID=
# API token with "D1: Edit" and "Stream: Edit"
CLOUDFLARE_API_TOKEN=
# from `wrangler d1 create felll` (also in wrangler.jsonc)
D1_DATABASE_ID=
